mkdir - make directory
touch - make a file
echo - print out something
    echo "Hello world" > name.txt - prints hello world inside the file name.txt.
cp - for creating a copy of either a directory or a file
  for a file: cp name.txt copy_name.txt  - creates a copy of name.txt
  for a directory - cp -r testdir copy_testdir 
  the copies created exist under the curent working directory
mv - to rename files eg. mv name.txt my_name.txt
   - to move files into directories - mv {file name} {directory name}/ 
   - in one line: mv {directory name}/{file name} ./{new name}
rm -  to remove files or directories
    rm name.txt - removes name.txt
    rmdir testdir - removes a directory. If the directory is not empty, use rmdir rf testdir
cat - cat {file path} reads the content of a file
head -  head -n1 {path} reads the first line of your file or else further specified
tail - same use case as head only difference is it is used to read from the bottom
chown - change ownership
    e.g sudo chown root:root {name of file}
        sudo chown -R root:root {name of file} > for directories
chmod - change permisions for self, goup and others
    e.g chmod 700 {file name}
    4: Read permission 2: Write permission 1: Execute permission 0: No permission
    Using letters, user:u others:o and group:g
    to change both owner and group: sudo chown username:groupname filename.txt
